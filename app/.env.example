# ============================================================
# school-app — 環境変数サンプル
# このファイルをコピーして .env.local を作成し、各値を設定してください。
# NEXT_PUBLIC_ 以外の変数は絶対に公開しないこと。
# ============================================================

# ─── Supabase ───────────────────────────────────────────────
# Supabase ダッシュボード → Settings → API
# 「Publishable and secret API keys」タブの値を使うこと
# （JWT署名鍵が ECC にローテーションされたプロジェクトでは、
#  旧 anon / service_role キー(eyJ...)では RLS が正しく効かない）
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxx
# ⚠️ Secret キー — RLS をバイパスする最重要キー。
#    NEXT_PUBLIC_ を付けないこと。リポジトリにコミットしないこと。
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxx

# ─── アプリ URL（任意）──────────────────────────────────────
# 通常は不要。招待リンクやメールのリダイレクト先はリクエストから自動判定される。
# リクエストヘッダが取れない特殊な環境でのみ、保険として設定する。
# NEXT_PUBLIC_APP_URL=http://localhost:3000
